# Polymarket / Polygon wallet
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
PRIVATE_KEY=

# Runtime
CHAIN_ID=137
DRY_RUN=true

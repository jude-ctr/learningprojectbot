# ── Polymarket / Polygon wallet ──────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
PRIVATE_KEY=

# ── Runtime ──────────────────────────────────────────────────────────
CHAIN_ID=137
DRY_RUN=true
LOG_LEVEL=INFO
MAX_OPEN_ORDERS=50
MAX_POSITION_SIZE_USD=100.0

# ── Shutdown behaviour ─────────────────────────────────────────────
# When true, Ctrl+C cancels all open orders on Polymarket before exiting.
# Set to false to leave orders on the book after stopping the bot.
CANCEL_ON_SHUTDOWN=true

# ── Market scope (which markets the bot trades) ────────────────────
# Options: "all", "btc", "crypto", "btc+crypto", "non_btc_crypto"
#   all        = every market on Polymarket
#   btc        = only Bitcoin-related markets
#   crypto     = BTC + altcoins/DeFi/exchanges
#   btc+crypto = same as "crypto"
#   non_btc_crypto = crypto markets excluding BTC
MARKET_SCOPE=all

# ── Strategy toggles (set to false to disable) ──────────────────────
SPREAD_ENABLED=true
MARKET_TIMING_ENABLED=true
BTC_STRATEGY_ENABLED=true
CRYPTO_STRATEGY_ENABLED=true

# ── Midpoint spread strategy ────────────────────────────────────────
# (no extra params – controlled by SPREAD_ENABLED above)

# ── Market-timing hedge strategy ────────────────────────────────────
# Scope: which markets this strategy runs on (same options as MARKET_SCOPE)
MARKET_TIMING_SCOPE=all
MARKET_TIMING_LOOKBACK=20
MARKET_TIMING_EMA_FAST=5
MARKET_TIMING_EMA_SLOW=15
MARKET_TIMING_MOMENTUM_THRESHOLD=0.02
MARKET_TIMING_HEDGE_RATIO=0.5
MARKET_TIMING_BASE_SIZE_USD=10.0
MARKET_TIMING_MAX_LEVERAGE=3.0
MARKET_TIMING_MAX_EXPOSURE_USD=500.0
MARKET_TIMING_MAX_POSITIONS=5

# ── Bitcoin strategy ────────────────────────────────────────────────
BTC_BASE_SIZE_USD=15.0
BTC_MAX_LEVERAGE=3.0
BTC_MAX_EXPOSURE_USD=500.0
BTC_MOMENTUM_THRESHOLD=0.015
BTC_EMA_FAST=4
BTC_EMA_SLOW=12
BTC_LOOKBACK=20
BTC_HEDGE_RATIO=0.6

# ── Crypto broad strategy ──────────────────────────────────────────
CRYPTO_BASE_SIZE_USD=10.0
CRYPTO_MAX_LEVERAGE=2.5
CRYPTO_MAX_EXPOSURE_USD=400.0
CRYPTO_MOMENTUM_THRESHOLD=0.02
CRYPTO_EMA_FAST=5
CRYPTO_EMA_SLOW=15
CRYPTO_LOOKBACK=20
CRYPTO_HEDGE_RATIO=0.4

# ── Confluence mode ─────────────────────────────────────────────────
# When enabled, signals only execute if multiple strategies agree
# on the same market + direction. Boosts size when they do.
CONFLUENCE_ENABLED=false
CONFLUENCE_MIN_AGREE=2
CONFLUENCE_SIZE_BOOST=1.5

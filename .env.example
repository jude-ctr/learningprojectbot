# Market-timing hedge strategy (set to false to disable entirely)
MARKET_TIMING_ENABLED=true
MARKET_TIMING_LOOKBACK=20
MARKET_TIMING_EMA_FAST=5
MARKET_TIMING_EMA_SLOW=15
MARKET_TIMING_MOMENTUM_THRESHOLD=0.02
MARKET_TIMING_HEDGE_RATIO=0.5
MARKET_TIMING_BASE_SIZE_USD=10.0
MARKET_TIMING_MAX_LEVERAGE=3.0
MARKET_TIMING_MAX_EXPOSURE_USD=500.0
MARKET_TIMING_MAX_POSITIONS=5
